# Copiar a .env.local y rellenar con los valores del proyecto de Supabase
# (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sólo servidor. NO empezar por NEXT_PUBLIC_: se salta RLS.
# Se usa para moderación y limpieza, no para el uso normal de la app.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: estilo de mapa alternativo (por defecto OpenFreeMap Liberty).
# NEXT_PUBLIC_MAP_STYLE_URL=
