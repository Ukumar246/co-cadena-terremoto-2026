# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...menos la plantilla, que sí debe viajar con el repo
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

logs/

# Vista previa local de las imágenes de prueba (`npm run seed:images -- --local`).
# Las de verdad viven en el bucket de Supabase, no en el repo.
.seed-images/
